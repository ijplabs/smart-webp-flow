{
    "name": "ijplabs/smart-webp-flow",
    "description": "Lightweight and modern WebP converter for WordPress. Converts JPG/PNG uploads automatically, provides background chunked bulk sync for existing media, and seamlessly updates post content references without website downtime.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/ijplabs/smart-webp-flow",
    "authors": [
        {
            "name": "IJPLabs",
            "homepage": "https://ijplabs.com"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13.5",
        "wp-coding-standards/wpcs": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "SmartWebPFlow\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs --standard=.phpcs.xml.dist",
        "lint-fix": "phpcbf --standard=.phpcs.xml.dist"
    }
}
